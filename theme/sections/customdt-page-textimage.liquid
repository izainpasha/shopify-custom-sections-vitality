  .textimagepage-pagetitle{

  }
  .textimagepage-inner{
    display: grid;
    grid-template-columns: 500px 1fr;
    gap: 68px;
  }

  .textimagepage-inner-right-title{
    font-style: normal;
    font-weight: 700;
    font-size: 40px;
    line-height: 120%;
    text-transform: capitalize;
    color: #183013;
    margin: 0;
  }
  .textimagepage-inner-right-title span{
    color: #56a535;
  }
  .textimagepage-inner-right-subtitle{
    margin-top: 24px;
    font-style: normal;
    font-weight: 500;
    font-size: 20px;
    line-height: 140%;
    color: #1D1F1E;
  }
  .textimagepage-inner-right-text{
    margin-top: 24px;
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 160%;
    color: #1D1F1E;
  }
  @media(max-width: 799px){
    .textimagepage-inner-right-title{
        font-size: 28px;
    }
    .textimagepage-inner-right-subtitle{
        font-size: 20px;
    }
    .textimagepage-inner-right-text{
        font-size: 14px;
    }
    .textimagepage{
        padding: 45px 0;
    }
    .textimagepage-inner{
        grid-template-columns: 1fr;
    }
    .textimagepage-inner{
        gap: 32px;
    }
  }
{%- endstyle -%}

<section class="textimagepage">
    <div class="container">
        <div class="textimagepage-inner">
            <div class="textimagepage-inner-left">
                <img src="{{section.settings.image | img_url:'master' }}">
            </div>

            <div class="textimagepage-inner-right">
                <h2 class="textimagepage-inner-right-title">
                    {{ section.settings.title }}
                </h2>
                <div class="textimagepage-inner-right-subtitle">
                    {{ section.settings.subtitle }}
                </div>
                <div class="textimagepage-inner-right-text">
                    {{ section.settings.text }}
                </div>
            </div>
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Custom page textimage",
  "tag": "section",
  "class": "section",
  "settings": [
    {
        "type": "html",
        "id": "title",
        "default": "Title",
        "label": "Title"
    },
    {
        "type": "text",
        "id": "subtitle",
        "default": "SubTitle",
        "label": "SubTitle"
    },
    {
        "type": "text",
        "id": "text",
        "default": "Text",
        "label": "Text"
    },
    {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Custom page textimage"
    }
  ]
}
{% endschema %}
