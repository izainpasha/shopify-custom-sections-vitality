{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* === Modal Styles === */
  .reviews-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }
  .reviews-modal.is-open {
    display: flex;
  }
  .reviews-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.85);
    cursor: pointer;
  }
  .reviews-lightbox {
    position: relative;
    z-index: 1;
    width: min(420px, 92vw);
    /* width: 90vw; */
    max-width: 900px;
    background: #000;
    border-radius: 8px;
    overflow: hidden;
  }
  .reviews-lightbox video {
    width: 100%;
    display: block;
    max-height: 80vh;
    object-fit: cover; 
    /* object-fit: contain; */
  }
  .reviews-modal-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    background: rgba(0,0,0,0.5);
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    cursor: pointer;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .reviews-modal-mute {
    position: absolute;
    bottom: 10px;
    right: 10px;
    z-index: 2;
    background: rgba(0,0,0,0.5);
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    cursor: pointer;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .reviews-modal-mute .mute-on,
  .reviews-modal-mute.is-muted .mute-off {
    display: flex;
  }
  .reviews-modal-mute .mute-off,
  .reviews-modal-mute.is-muted .mute-on {
    display: none;
  }
{%- endstyle -%}

<section class="reviews">
  <div class="container">
    <div class="reviews-inner">
      <div class="reviews-head">
        <h2 class="reviews-title">{{ section.settings.title }}</h2>
        <p class="reviews-subtitle">{{ section.settings.subtitle }}</p>
      </div>

      <div class="reviews-wrapper">
        <div class="reviews-slider swiper">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              {% liquid
                assign video_src = blank
                if block.settings.video != blank
                  for source in block.settings.video.sources
                    if source.mime_type contains 'mp4'
                      assign video_src = source.url
                      break
                    endif
                  endfor
                endif
              %}

              {% if video_src != blank %}
                <div
                  class="swiper-slide reviews-item"
                  data-open-modal="reviews-modal-{{ section.id }}-{{ forloop.index }}"
                  style="cursor:pointer;"
                >
                  <img src="{{ block.settings.image | img_url: 'master' }}" alt="review" />
                  <div class="reviews-play">
                    <img src="https://cdn.shopify.com/s/files/1/0582/8804/6267/files/play.svg?v=1764269351" alt="play" />
                  </div>
                </div>
              {% else %}
                <div class="swiper-slide reviews-item">
                  <img src="{{ block.settings.image | img_url: 'master' }}" alt="review" />
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <div class="reviews-nav">
          <button class="btn-arrow btn-arrow--next"></button>
          <div class="swiper-pagination"></div>
          <button class="btn-arrow btn-arrow--prev"></button>
        </div>
      </div>

      <ul class="reviews-list">
        <li class="reviews-list-item">
          <span class="reviews-value">{{ section.settings.item1value }}</span>
          <p class="reviews-text">{{ section.settings.item1 }}</p>
        </li>
        <li class="reviews-list-item">
          <span class="reviews-value">{{ section.settings.item2value }}</span>
          <p class="reviews-text">{{ section.settings.item2 }}</p>
        </li>
        <li class="reviews-list-item">
          <span class="reviews-value">{{ section.settings.item3value }}</span>
          <p class="reviews-text">{{ section.settings.item3 }}</p>
        </li>
      </ul>
    </div>
  </div>
</section>

<!-- Modals -->
{% for block in section.blocks %}
  {% liquid
    assign video_src = blank
    assign poster = block.settings.image
    if block.settings.video != blank
      for source in block.settings.video.sources
        if source.mime_type contains 'mp4'
          assign video_src = source.url
          break
        endif
      endfor
    endif
  %}

  {% if video_src != blank %}
    <div class="reviews-modal" id="reviews-modal-{{ section.id }}-{{ forloop.index }}">
      <div class="reviews-modal-backdrop" data-close-modal></div>

      <div class="reviews-lightbox" role="dialog" aria-modal="true" aria-label="Video testimonial">
        <button class="reviews-modal-close" data-close-modal aria-label="Close video">
          <svg viewBox="0 0 24 24" width="20" height="20" focusable="false">
            <path d="M18.3 5.71 12 12l6.3 6.29-1.41 1.41L10.59 13.41 4.29 19.7 2.88 18.29 9.17 12 2.88 5.71 4.29 4.3l6.3 6.29 6.29-6.3z" fill="currentColor"/>
          </svg>
        </button>

        <button class="reviews-modal-mute is-muted" data-toggle-mute aria-label="Toggle sound">
          <span class="mute-on">
            <svg viewBox="0 0 24 24" width="20" height="20" focusable="false">
              <path d="M14.5 5.5 9.8 9H6.5A1.5 1.5 0 0 0 5 10.5v3A1.5 1.5 0 0 0 6.5 15h3.3l4.7 3.5V5.5Z" fill="none" stroke="currentColor" stroke-width="1.5"/>
              <path d="M17 10a3 3 0 0 1 0 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M18.8 8a5.8 5.8 0 0 1 0 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="mute-off">
            <svg viewBox="0 0 24 24" width="20" height="20" focusable="false">
              <path d="M14.5 5.5 9.8 9H6.5A1.5 1.5 0 0 0 5 10.5v3A1.5 1.5 0 0 0 6.5 15h3.3l4.7 3.5V5.5Z" fill="none" stroke="currentColor" stroke-width="1.5"/>
              <path d="M7 17 17 7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </span>
        </button>

        <video
          playsinline
          webkit-playsinline
          loop
          muted
          preload="metadata"
          {% if poster != blank %}poster="{{ poster | img_url: 'master' }}"{% endif %}
          src="{{ video_src }}"
          data-video
        ></video>
      </div>
    </div>
  {% endif %}
{% endfor %}

<script>
(function () {
  // Open modal
  document.querySelectorAll('[data-open-modal]').forEach(function (trigger) {
    trigger.addEventListener('click', function () {
      var modalId = trigger.getAttribute('data-open-modal');
      var modal = document.getElementById(modalId);
      if (!modal) return;

      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';

      var video = modal.querySelector('[data-video]');
      if (video) {
        video.currentTime = 0;
        video.muted = true;
        var muteBtn = modal.querySelector('[data-toggle-mute]');
        if (muteBtn) muteBtn.classList.add('is-muted');
        video.play();
      }
    });
  });

  // Close modal
  function closeModal(modal) {
    if (!modal) return;
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
    var video = modal.querySelector('[data-video]');
    if (video) {
      video.pause();
      video.currentTime = 0;
    }
  }

  document.querySelectorAll('[data-close-modal]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var modal = btn.closest('.reviews-modal');
      closeModal(modal);
    });
  });

  // Close on Escape key
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      var openModal = document.querySelector('.reviews-modal.is-open');
      closeModal(openModal);
    }
  });

  // Mute toggle
  document.querySelectorAll('[data-toggle-mute]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var modal = btn.closest('.reviews-modal');
      var video = modal ? modal.querySelector('[data-video]') : null;
      if (!video) return;
      video.muted = !video.muted;
      btn.classList.toggle('is-muted', video.muted);
    });
  });
})();
</script>
<script>
(function() {
  // Wait for Swiper to be available
  function initSwiper() {
    if (typeof Swiper === 'undefined') {
      setTimeout(initSwiper, 100);
      return;
    }

    var swiper = new Swiper('.reviews-slider', {
      slidesPerView: 'auto',
      spaceBetween: 16,
      loop: true,
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
    });

    // Hook up the custom arrow buttons
    var nextBtn = document.querySelector('.btn-arrow--next');
    var prevBtn = document.querySelector('.btn-arrow--prev');

    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        swiper.slideNext();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        swiper.slidePrev();
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initSwiper);
})();
</script>

{% schema %}
{
  "name": "Custom Reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "html",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "SubTitle"
    },
    {
      "type": "text",
      "id": "item1",
      "label": "Item 1 text"
    },
    {
      "type": "text",
      "id": "item1value",
      "label": "Item 1 Value"
    },
    {
      "type": "text",
      "id": "item2",
      "label": "Item 2 text"
    },
    {
      "type": "text",
      "id": "item2value",
      "label": "Item 2 Value"
    },
    {
      "type": "text",
      "id": "item3",
      "label": "Item 3 text"
    },
    {
      "type": "text",
      "id": "item3value",
      "label": "Item 3 Value"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "A Shopify-hosted video"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Reviews"
    }
  ]
}
{% endschema %}