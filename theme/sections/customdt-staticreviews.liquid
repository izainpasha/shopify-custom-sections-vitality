{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}

<style>
    .lp-reviews-{{ section.id }}{
        padding: 50px 0;
    }
    .lp-reviews-title{
        text-align: center;
        margin: 0;
        font-style: normal;
        font-weight: 400;
        font-size: 24px;
        line-height: 120%;
        color: #183013;
        margin-bottom: 48px;
    }
    .lp-reviews-title em{
        color: {{ section.settings.icolor }};
        font-style: normal;
    }
    .lp-reviews-items{
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
    }
    .lp-reviews-items-block{
        grid-template-columns: 1fr;
        gap: 15px;
    }
    .lp-reviews-items-block img{
        display:block;
        width: 100%;
    }
    @media(max-width: 799px){
        .lp-reviews-items{
            grid-template-columns: 1fr;
        }
    }
    .lp-reviews-rating{
        margin-bottom: 24px;
    }
    .lp-reviews-rating svg{
        display:block;
        width: 100%;
        max-width: 700px;
        margin: auto;
    }
</style>

