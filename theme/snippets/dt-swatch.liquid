<script>
  var parser = new DOMParser();
  var originPrice = '{{ price | money }}';
  const currency = window.Shopify?.currency?.active ?? 'USD';

  const formId = '{{ product_form_id }}';
  const form = document.getElementById(formId);

  function formatMoney(newMoney) {
    const originPriceNumber = originPrice.replace(/[^0-9.,]/g, '');
    return `${originPrice.replace(originPriceNumber, newMoney)} ${currency}`;
  }
  function formatMoneyWithoutSuffix(newMoney) {
    const originPriceNumber = originPrice.replace(/[^0-9.,]/g, '');
    return `${originPrice.replace(originPriceNumber, newMoney)}`;
  }
</script>
<script>
  const locale = window.Shopify?.locale ?? "en";
  const country = window.Shopify?.country;
  const countryLocale = locale.includes("-") ? locale : `${locale}-${country}`;

document.addEventListener('click', function(e) {

  const formatter = new Intl.NumberFormat(countryLocale, {
    minimumFractionDigits: 2
  });
  const productPriceLabel = document.querySelector(".price-item--last");
  const comparePriceLabel = document.querySelectorAll(".price-item--regular");

  const variantPrice = {{ current_variant.price | json }};
  const variantComparePrice = {{ current_variant.compare_at_price | default: 0 | json }};

  const el = e.target.closest('.dtpdp-options-group2-items-val');
  if (!el) return;

  const q = parseInt(el.dataset.quantity, 10) || 1;

  // 1) Find your specific form
  const form = document.querySelector('.product-form__submit');
  if (!form) return;

  // 2) Ensure quantity input exists
  let qty = form.querySelector('input[name="quantity"]');
  if (!qty) {
    qty = document.createElement('input');
    qty.type = 'hidden';
    qty.name = 'quantity';
    form.appendChild(qty);
  }

  // 3) Update value + form attribute + notify listeners
  qty.value = q;
  form.setAttribute('data-quantity', q);
  qty.dispatchEvent(new Event('change', { bubbles: true }));

  if (typeof updateCartButtonPrice === 'function') {
    updateCartButtonPrice(q);
  }

  const totalPrice = variantPrice * q;
  const formattedPrice = formatter.format(totalPrice / 100);
  
  const totalComparePrice = variantComparePrice * q;
  const formattedComparePrice = formatter.format(totalComparePrice / 100);


  console.log(comparePriceLabel)

  if (productPriceLabel){
    comparePriceLabel.innerText = formatMoneyWithoutSuffix(formattedComparePrice);
    comparePriceLabel.forEach(function(item, index) {
      item.innerText = formatMoneyWithoutSuffix(formattedComparePrice);
    });
  }
  if (productPriceLabel){
    productPriceLabel.innerHTML = formatMoneyWithoutSuffix(formattedPrice);
  }

  // 4) Toggle active state within the same group
  const group = el.closest('.dtpdp-options-group2-items') || document;
  group.querySelectorAll('.dtpdp-options-group2-items-val.active').forEach(n => {
    n.classList.remove('active');
    n.setAttribute('aria-pressed', 'false');
  });
  el.classList.add('active');
  el.setAttribute('aria-pressed', 'true');
});
</script>

  <script>
  document.addEventListener('DOMContentLoaded', function () {
    var dropdowns = document.querySelectorAll('[data-strength-dropdown]');

    dropdowns.forEach(function (dropdown) {
      var trigger = dropdown.querySelector('.strength-dropdown__trigger');
      var menu = dropdown.querySelector('.strength-dropdown__menu');

      if (!trigger || !menu) return;

      trigger.addEventListener('click', function () {
        var isOpen = dropdown.classList.contains('is-open');

        document.querySelectorAll('[data-strength-dropdown].is-open').forEach(function (openDropdown) {
          openDropdown.classList.remove('is-open');
          var openTrigger = openDropdown.querySelector('.strength-dropdown__trigger');
          var openMenu = openDropdown.querySelector('.strength-dropdown__menu');

          if (openTrigger) openTrigger.setAttribute('aria-expanded', 'false');
          if (openMenu) openMenu.hidden = true;
        });

        if (!isOpen) {
          dropdown.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
          menu.hidden = false;
        }
      });
    });

    document.addEventListener('click', function (event) {
      document.querySelectorAll('[data-strength-dropdown]').forEach(function (dropdown) {
        if (!dropdown.contains(event.target)) {
          dropdown.classList.remove('is-open');

          var trigger = dropdown.querySelector('.strength-dropdown__trigger');
          var menu = dropdown.querySelector('.strength-dropdown__menu');

          if (trigger) trigger.setAttribute('aria-expanded', 'false');
          if (menu) menu.hidden = true;
        }
      });
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        document.querySelectorAll('[data-strength-dropdown]').forEach(function (dropdown) {
          dropdown.classList.remove('is-open');

          var trigger = dropdown.querySelector('.strength-dropdown__trigger');
          var menu = dropdown.querySelector('.strength-dropdown__menu');

          if (trigger) trigger.setAttribute('aria-expanded', 'false');
          if (menu) menu.hidden = true;
        });
      }
    });
  });
</script>
